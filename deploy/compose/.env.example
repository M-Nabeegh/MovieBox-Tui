MOVIEBOX_DATA_ROOT=/srv/moviebox
MOVIEBOX_BIND=0.0.0.0:8420
MOVIEBOX_MAX_HEIGHT=1080
MOVIEBOX_DOWNLOAD_CONCURRENCY=1
MOVIEBOX_RESERVE_GIB=10
# Subtitle language attached when a download does not name one.
# Defaults to English when unset; use `off` to disable automatic subtitles.
MOVIEBOX_SUBTITLE_LANGUAGE=english
# Optional features. Create the secret file, then uncomment the matching line.
# Jellyfin API key: lets the server trigger a library scan after each download.
#MOVIEBOX_JELLYFIN_API_KEY_FILE=/run/secrets/jellyfin_api_key
# MCP bearer token: enables the agent endpoint at /mcp. Unset keeps it disabled.
#MOVIEBOX_MCP_TOKEN_FILE=/run/secrets/mcp_token
MOVIEBOX_UID=1000
MOVIEBOX_GID=1000
JELLYFIN_RENDER_GID=993
JELLYFIN_PUBLISHED_PORT=8096
