# Defaults to English when unset; use `off` to disable automatic subtitles.
MOVIEBOX_SUBTITLE_LANGUAGE=english
MOVIEBOX_UID=1000
MOVIEBOX_GID=1000
JELLYFIN_RENDER_GID=993
JELLYFIN_PUBLISHED_PORT=8096
